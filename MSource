○BasePoint生成ロジックを実装
・Pos
vector adjust_pos = chv("AdjustPos");

float block_width = ch("BlockWidth");
int verts[] = primvertices(0, @primnum);

// ループしてvertex Nを取得
for(int i = 0; i < len(verts) - 1; i++) 
{
    int pt1_num = vertexpoint(0, verts[i]);
    int pt2_num = vertexpoint(0, verts[i + 1]);
    
    vector pt1 = point(0, "P", pt1_num);
    vector pt2 = point(0, "P", pt2_num);
	
    vector dir = normalize(pt2 - pt1);
    float length = length(pt2 - pt1);

    int block_num = int(length / block_width);
    vector slider = dir * length / block_num;
	
	vector up = vertex(0, "up", verts[i]);
	vector pt1_normal = vertex(0, "N", verts[i]);
	vector pt2_normal = vertex(0, "N", verts[i + 1]);
	vector normal = normalize((pt1_normal + pt2_normal) / 2);	   

	vector slider_pos = 0;
	slider_pos += dir * adjust_pos.x;
	slider_pos += up * adjust_pos.y;
	slider_pos += normal * adjust_pos.z;

    for(int j = 0; j < block_num; j++)
    {
        vector spawn_pos = pt1 + slider / 2;
        spawn_pos += j * slider;
		spawn_pos += slider_pos;
        int pt = addpoint(0, spawn_pos);
        
        setpointattrib(0, "N", pt, normal);
    }
}

removeprim(0, @primnum, 1);

