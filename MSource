vector base_size = chv("BaseSize");
float edge_angle = ch("EdgeAngle");

//中点の生成
vector pt_center_pos = set(0, 0, 0);
int pt_center = addpoint(0, pt_center_pos);

//端点の生成
vector pt_side_1_pos = pt_center_pos;
pt_side_1_pos.x += base_size.x;
int pt_side_1 = addpoint(0, pt_side_1_pos);

vector pt_side_2_dir = set(base_size.z, 0, 0);
vector rotate_axis = {0, 1, 0};
vector4 q = quaternion(radians(edge_angle), rotate_axis);
vector pt_side_2_pos = pt_center_pos;
pt_side_2_pos += qrotate(q, pt_side_2_dir);
int pt_side_2 = addpoint(0, pt_side_2_pos);

//高さ、斜角に応じて上部点を生成
vector pt_top_pos = pt_center_pos;
pt_top_pos.y += base_size.y;
vector pt_top_dir = normalize((normalize(pt_side_1_pos - pt_center_pos) + normalize(pt_side_2_pos - pt_center_pos)) * 0.5);
pt_top_dir *= -1 * 2;
pt_top_pos += pt_top_dir;
int pt_top = addpoint(0, pt_top_pos);

//primを生成
int prim = addprim(0, "poly");
addvertex(0, prim, pt_side_1);
addvertex(0, prim, pt_center);
addvertex(0, prim, pt_top);

prim = addprim(0, "poly");
addvertex(0, prim, pt_side_2);float middle = ch("Middle");
vector dir_rotate = chv("Dir_Rotate");
dir_rotate = radians(dir_rotate);
vector grid_rotate = chv("Grid_Rotate");
grid_rotate = radians(grid_rotate);
vector center_pos = detail(1, "centroid");

vector4 q_dir_rotate = eulertoquaternion(dir_rotate, 0);
vector base_dir = set(0, 1, 0);
vector dir = qrotate(q_dir_rotate, base_dir);
dir = normalize(dir);

float bounds[] = detailintrinsic(1, "bounds");
vector min_all = set(bounds[0], bounds[2], bounds[4]);
vector max_all = set(bounds[1], bounds[3], bounds[5]);
vector ray = dir * length(min_all - max_all);

vector min_pos, max_pos, hit_uv;
intersect(1, center_pos, ray, max_pos, hit_uv);
intersect(1, center_pos, -ray, min_pos, hit_uv);

float bound_length = length(max_pos - min_pos);
int pt_num = int(bound_length / middle);
vector slider = dir * bound_length / pt_num;

vector4 q_grid_rotate = eulertoquaternion(grid_rotate, 0);

for(int i = 0; i < pt_num; i++)
{
    vector spawn_pos = min_pos + slider * i;
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "orient", pt, q_grid_rotate, "set");
}
addvertex(0, prim, pt_center);
addvertex(0, prim, pt_top);


