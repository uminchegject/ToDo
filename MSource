int toggleRunning = 0;
int seed = detail(0, "Seed");

int typeNum = chi("TypeNum");
string strAddTypeParam = chs("AddTypeList");
vector transform = chv("Transform");
vector scale = chv("scale");     
vector rotateAxis = chv("RotateAxis");
float rotateValue = ch("RotateValue");

//タイプに含まれているか
int typeNumList[] = i[]@TypeNumList;

for(int i = 0; i < len(typeNumList); i++)
{
    if(typeNumList[i] == typeNum)
    {
        removeindex(typeNumList, i);
        toggleRunning = 1;
        break;
    }
}


if(toggleRunning == 1)
{
    
    //回転周り
    vector local_normal = {1, 0, 0};
    vector world_normal = qrotate(p@orient, local_normal);
    vector4 quat = quaternion(radians(rotateValue), rotateAxis);   
    vector4 orient = qmultiply(p@orient, quat);   
    
    //移動
    vector MoveVector;
    MoveVector.x = transform.x * v@scale.x;
    MoveVector.y = transform.y * v@scale.y;
    MoveVector.z = transform.z * v@scale.z;  
    MoveVector = qrotate(p@orient, MoveVector);
    transform = MoveVector + v@P; 
    
    //ボリュームスケール
    scale *= v@scale;
       
    //typeを追加
    string strAddTypeParamBlockList[] = re_split(",", strAddTypeParam);
    foreach(string strAddTypeParamBlock; strAddTypeParamBlockList)
    {
        string strAddTypeParamList[] = re_split("_", strAddTypeParamBlock);
        int addTypeNumList[];
        foreach(string str; strAddTypeParamList)
        {
            append(addTypeNumList, atoi(str));
        }
        int type = addTypeNumList[int(floor(rand(@ptnum + seed) * len(addTypeNumList)))];
        append(typeNumList, type);
    }
    
	v@P = transform;
	v@scale = scale;
	v@orient = orient;
	i[]@TypeNumList = typeNumList;
}
