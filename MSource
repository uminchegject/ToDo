○DetailAssetの配置
・短い辺のサイズを基準にする
・高さは範囲を設定しランダムに決める

vector heightRange = {1.0, 1.5, 0};
float height = random(v@P) * (heightRange.y - heightRange.x) + heightRange.x;

float depth = v@scale.x;
if(v@scale.y < v@scale.x) depth = v@scale.y;

vector slidableVector = 0;
if(v@scale.x < v@scale.z) slidableVector.z = v@scale.z - v@scale.x;
else slidableVector.x = v@scale.x - v@scale.z;
slidableVector /= 2;

vector spawnPos = v@P;
spawnPos.y += height / 2;
spawnPos += random(v@P) * slidableVector;

vector scale = v@scale;
scale.y = height;
if(v@scale.x < v@scale.z) scale.z = v@scale.x;
else scale.x = v@scale.z;

v@P = spawnPos;
v@scale = scale;


