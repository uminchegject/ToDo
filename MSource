●BasePointの生成
float pattern_height = ch("../Param/PatternHeight");
vector bound_size = detail(1 ,"radii", 0);
bound_size *= 2.2;

vector rotate = chv("../Param/PatternRotate");
matrix3 rot_x = ident();
rotate(rot_x, rotate.x, {1, 0, 0});
matrix3 rot_z = ident();
rotate(rot_z, rotate.y, {0, 0, 1});
matrix3 rot_total = rot_z * rot_x; 

vector vec = {0, 1, 0};
vector rotated_vec = rot_total * vec;
vector4 q_total = dihedral(vec, rotated_vec);

vector scale = set(bound_size.z / cos(rotate.y), 0, bound_size.x / cos(rotate.x));

int grid_num = int(bound_size.y / pattern_height);
float pattern_interval = bound_size.y / grid_num;

for(int i = 1; i < grid_num; ++i)
{
    vector spawn_pos = prim(1, "P", 4);
    spawn_pos.y += i * pattern_interval;
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "scale", pt, scale);
    setpointattrib(0, "orient", pt, q_total);
}

●平面とベクトルの交点
// 線分の2点（テスト用）
vector p0 = set(0, 0, 0);
vector p1 = set(0, 2, 0);

// 平面：Y = 1
vector planeN = normalize(chv("Normal")); // 法線ベクトル
float d = -1.0; // 平面方程式：dot(N, P) + d = 0

// 線分方向
vector dir = p1 - p0;
float denom = dot(planeN, dir);

// 平面法線の可視化：p0 から planeN 方向に矢印を描く
vector arrow_end = p0 + planeN;
int n0 = addpoint(0, p0);
int n1 = addpoint(0, arrow_end);
int norm_line = addprim(0, "polyline");
addvertex(0, norm_line, n0);
addvertex(0, norm_line, n1);
setprimattrib(0, "Cd", norm_line, {1, 1, 0}, "set"); // 黄色で可視化

// 交差計算
if (abs(denom) > 1e-6) {
    float t = -(dot(planeN, p0) + d) / denom;

    if (t >= 0 && t <= 1) {
        vector isect = p0 + t * dir;

        // 線分と交点の可視化
        int pt0 = addpoint(0, p0);
        int pt1 = addpoint(0, p1);
        int isectpt = addpoint(0, isect);

        int line1 = addprim(0, "polyline");
        addvertex(0, line1, pt0);
        addvertex(0, line1, pt1);

        int line2 = addprim(0, "polyline");
        addvertex(0, line2, pt0);
        addvertex(0, line2, isectpt);

        // カラー付け
        setpointattrib(0, "Cd", pt0, {0,1,0}, "set");       // 線の始点：緑
        setpointattrib(0, "Cd", pt1, {0,0.5,1}, "set");     // 線の終点：青
        setpointattrib(0, "Cd", isectpt, {1,0,0}, "set");   // 交点：赤
    }
}


