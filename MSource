■ソース
●ソース(Grid)
float middle = ch("Middle");
vector dir_rotate = chv("Dir_Rotate");
dir_rotate = radians(dir_rotate);
vector grid_rotate = chv("Grid_Rotate");
grid_rotate = radians(grid_rotate);
vector center_pos = detail(1, "centroid");

vector4 q_dir_rotate = eulertoquaternion(dir_rotate, 0);
vector base_dir = set(0, 1, 0);
vector dir = qrotate(q_dir_rotate, base_dir);
dir = normalize(dir);

float bounds[] = detailintrinsic(1, "bounds");
vector min_all = set(bounds[0], bounds[2], bounds[4]);
vector max_all = set(bounds[1], bounds[3], bounds[5]);
vector ray = dir * length(min_all - max_all);

vector min_pos, max_pos, hit_uv;
intersect(1, center_pos, ray, max_pos, hit_uv);
intersect(1, center_pos, -ray, min_pos, hit_uv);

float bound_length = length(max_pos - min_pos);
int pt_num = int(bound_length / middle);
vector slider = dir * bound_length / pt_num;

vector4 q_grid_rotate = eulertoquaternion(grid_rotate, 0);

for(int i = 0; i < pt_num; i++)
{
    vector spawn_pos = min_pos + slider * i;
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "orient", pt, q_grid_rotate, "set");
}
