vector max_scale = chv("../Param/MaxScale")
float dot = dot(divide_axis, v@up);
float angle_rad = acos(dot);
if(length * abs(cos(angle_rad)) < max_scale.x && 0.5 < abs(cos(angle_rad)) || length * abs(sin(angle_rad)) < max_scale.y && 0.5 < abs(sin(angle_rad)))
{
    v@DivideAxis = divide_axis;  
    i@group_DividedToggle = 1;
}
else
{
    //BoolObjのBasePointを生成
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "up", pt, divide_axis);
    setpointattrib(0, "N", pt, normal);
    setpointattrib(0, "scale", pt, scale);
    removeprim(0, i@primnum, 1);
}
