●パラメーター
vector blockSize = chi("BlockSize");
string windowMaterial = chs("WindowMaterial");

float bumpHeight = ch("bumpHeight");
float bumpHeightExtrude = ch("BumpHeightExtrude");
string bumpHeightMaterial = chs("BumpHeightMaterial");

float bumpWidth = ch("BumpWidth");
float bumpWidthExtrude = ch("BumpWidthExtrude");
string bumpWidthMaterial = chs("BumpWidthMaterial");


●ソース
vector adjustScale = 1;
adjustScale.x = blockSurfaceSize.x;
adjustScale.y = bumpHeight;
for(int height = 0; height < heightPtNum; ++height)
{    
	vector spawnPos = v@P;
	spawnPos -= (slider_y * heightPtNum) / 2;
	spawnPos += height * slider_y + slider_y / 2;

	if(heightPt1.y == heightPt2.y && widthPt1.y == widthPt2.y) continue;
	int pt = addpoint(0, spawnPos);
	setpointattrib(0, "orient", pt, orient);
	setpointattrib(0, "scale", pt, adjustScale);
	setpointattrib(0, "ExtrudeHeight", bumpHeightExtrude);
	setpointattrib(0, "Material", bumpHeightMaterial);
}

adjustScale.y = blockSurfaceSize.y;
adjustScale.x = bumpWidth;
for(int width = 0; width < widthPtNum; ++width)
{
	vector spawnPos = v@P;
	spawnPos -= (slider_x * widthPtNum) / 2;
	spawnPos += width * slider_x + slider_x / 2;

	if(heightPt1.y == heightPt2.y && widthPt1.y == widthPt2.y) continue;
	int pt = addpoint(0, spawnPos);
	setpointattrib(0, "orient", pt, orient);
	setpointattrib(0, "scale", pt, adjustScale);	
	setpointattrib(0, "ExtrudeHeight", bumpWidthExtrude);
	setpointattrib(0, "Material", bumpWidthMaterial);
}

removeprim(0, @primnum, 1);
