・DivideAxisに沿ってBoolPlaneを生成
・Divide

●Attribute
・DivideToggle
・DivideAxis

●パラメーター
・Range
・DivideAngle

●仕様
・スケール範囲を設定
・DivideAngleで斜めも対応する
 -ランダム化

●ソース
//トグルが入ってない場合スキップ
int divide_toggle = 
if(divid_toggle != 1) return;

//BasePointの回転値を計算
vector divide_axis = v@up;
vector normal = v@N;
float divide_angle = radians(90);//radians(ch(../Param/DivideAngle));

matrix3 m_rotate = ident();
rotate(m_rotate, divide_angle, normal);
divide_axis *= m_rotate;


//BasePointの位置
float divide_ratio = 0.5 //ch(../Param);

vector center_pos;
for (int i = 0; i < nprimitives(0); i++) 
{
	center_pos += prim(0, "P", i);
}
center_pos /= nprimitives(0);

vector min_pos;
vector max_pos;
vector uvw;
intersect(0, center_pos, divide_axis, min_pos, uvw);
intersect(0, center_pos, -divide_axis, max_pos, uvw);

float length = length(min_pos - max_pos);

vector spawn_pos = base_pos;
spawn_pos += length * (divide_ratio - 0.5) * divide_axis;

//BoolPlaneのスケール
vector pt_edge_1 = point(0, "P", 0);
vector pt_edge_2 = point(0, "P", 4);
plane_length = length(pt_edge_1 - pt_edge_2);
vector scale = set(plane_length, 0, plane_length);

//BoolObjのBasePointを生成
int pt = add(point, spawn_pos);
setpointattrib(0, "up", pt, divide_axis);
setpointattrib(0, "scale", pt, scale);
