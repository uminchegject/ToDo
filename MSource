●ソース

float pattern_height = ch("../Param/PatternHeight");
vector bound_size = detail(1 ,"radii", 0);
bound_size *= 2;
float length = length(bound_size);

vector axis = ("../Param/Axis");
vector rotate = chv("../Param/PatternRotate");
matrix3 rot_x = ident();
rotate(rot_x, rotate.x, {1, 0, 0});
matrix3 rot_z = ident();
rotate(rot_z, rotate.y, {0, 0, 1});
matrix3 rot_total = rot_z * rot_x; 
vector vec = axis;
vector rotated_vec = rot_total * vec;
vector4 q_total = dihedral(vec, rotated_vec);

vector scale = set(length, 0, length);

int grid_num = int(bound_size.y / pattern_height);
float pattern_interval = bound_size.y / grid_num;
int offset = chi("../Param/Offset");
grid_num -= offset;

for(int i = offset; i < grid_num; ++i)
{
    vector spawn_pos = prim(1, "P", 4);
    spawn_pos += i * pattern_interval * axis;
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "scale", pt, scale);
    setpointattrib(0, "orient", pt, q_total);
}


