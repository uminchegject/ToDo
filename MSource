■LineBase
vector bound_size = detail(1 ,"radii", 0);
bound_size *= 2;
float length = length(bound_size);
vector scale = set(length, 0, length);

vector rotate = radians(chv("../Param/PatternRotate"));
matrix3 rot_x = ident();
rotate(rot_x, rotate.x, {1, 0, 0});
matrix3 rot_z = ident();
rotate(rot_z, rotate.y, {0, 0, 1});
matrix3 rot_total = rot_x * rot_z; 

vector base_vec = set(0, 1, 0);
vector rotated_vec = base_vec * rot_total;
vector4 q_total = dihedral(rotated_vec, base_vec);

float pattern_height = ch("../Param/PatternHeight");
int grid_num = int(bound_size.y / pattern_height);
float pattern_interval = bound_size.y / grid_num;
int offset = chi("../Param/PatternOffset");
grid_num -= offset;

vector axis_vec = normalize(chv("../Param/PatternAxis"));

for(int i = offset; i < grid_num; ++i)
{
    vector spawn_pos = prim(1, "P", 4);
    spawn_pos += i * pattern_interval * axis_vec;
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "scale", pt, scale);
    setpointattrib(0, "orient", pt, q_total);
}

■Greeble
//トグルが入ってない場合スキップ
int divide_toggle = 1;
if(divide_toggle != 1) return;

//BasePointの回転値を計算
vector divide_axis = v@up;
vector normal = v@N;
float divide_angle = radians(90); //radians(ch(../Param/DivideAngle));
matrix3 m_rotate = ident();
rotate(m_rotate, divide_angle, normal);
divide_axis *= m_rotate;

//BasePointの位置
float divide_ratio = random(@primnum) * 0.5 + 0.2; //ch(../Param);

vector center_pos = set(0, 0, 0);
for (int i = 0; i < nprimitives(1); i++) 
{
    center_pos += prim(1, "P", i);
}
center_pos /= nprimitives(1);

vector min_pos;
vector max_pos;
vector uvw;
intersect(1, center_pos, divide_axis * 1000, min_pos, uvw);
intersect(1, center_pos, -divide_axis * 1000, max_pos, uvw);


float length = length(min_pos - max_pos);

vector spawn_pos = center_pos;
spawn_pos += length * (divide_ratio - 0.5) * divide_axis;

//BoolPlaneのスケール
vector pt_edge_1 = point(1, "P", 0);
vector pt_edge_2 = point(1, "P", 6);
float plane_length = length(pt_edge_1 - pt_edge_2);
vector scale = set(plane_length, 0, plane_length);

//BoolObjのBasePointを生成
int pt = addpoint(0, spawn_pos);
setpointattrib(0, "up", pt, divide_axis);
setpointattrib(0, "N", pt, normal);
setpointattrib(0, "scale", pt, scale);

removeprim(0, @primnum, 1);
