●パラメーター
・PatternRotate
・PatternHeight
・PatternOffset
・PatternAxis

●ソース
vector bound_size = detail(1 ,"radii", 0);
bound_size *= 2;
float length = length(bound_size);
vector scale = set(length, 0, length);

vector rotate = radians(chv("../Param/PatternRotate"));
matrix3 rot_x = ident();
rotate(rot_x, rotate.x, {1, 0, 0});
matrix3 rot_z = ident();
rotate(rot_z, rotate.y, {0, 0, 1});
matrix3 rot_total = rot_x * rot_z; 

vector base_vec = set(0, 1, 0);
vector rotated_vec = base_vec * rot_total;
vector4 q_total = dihedral(rotated_vec, base_vec);

float pattern_height = ch("../Param/PatternHeight");
int grid_num = int(bound_size.y / pattern_height);
float pattern_interval = bound_size.y / grid_num;
int offset = chi("../Param/PatternOffset");
grid_num -= offset;

vector axis_vec = normalize(chv("../Param/PatternAxis"));

for(int i = offset; i < grid_num; ++i)
{
    vector spawn_pos = prim(1, "P", 4);
    spawn_pos += i * pattern_interval * axis_vec;
    int pt = addpoint(0, spawn_pos);
    setpointattrib(0, "scale", pt, scale);
    setpointattrib(0, "orient", pt, q_total);
}

//上部下部取得の為のBoolObjBasePointを生成
vector top_bool_pos = prim(1, "P", 4);
top_bool_pos += pattern_interval * offset * axis_vec;
int top_bool_pt = addpoint(0, top_bool_pos);
setpointattrib(0, "scale", top_bool_pt, scale);
setpointattrib(0, "orient", top_bool_pt, q_total);
setpointgroup(0, "TopBoolPt", top_bool_pt, 1);

vector bottom_bool_pos = prim(1, "P", 4);
bottom_bool_pos += pattern_interval * (grid_num - offset) * axis_vec;
int bottom_bool_pt = addpoint(0, bottom_bool_pos);
setpointattrib(0, "scale", bottom_bool_pt, scale);
setpointattrib(0, "orient", bottom_bool_pt, q_total);
setpointgroup(0, "BottomBoolPt", bottom_bool_pt, 1);

