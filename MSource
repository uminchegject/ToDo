○Rotate
float rotateAngle = radians(ch("RotateAngle"));
vector rotateAxis = {0, 1, 0};
vector4 quat = quaternion(rotateAngle, rotateAxis);   
quat = qmultiply(quat, p@orient);  

int primpts[] = primpoints(0, @primnum);
foreach(int pt; primpts)
{
    vector ptPos = point(0, "OriginPos", pt);
    ptPos -= v@P;
    ptPos = qrotate(quat, ptPos);
    ptPos += v@P;
    setpointattrib(0, "P", pt, ptPos);
}

