vector normal = v@N;
float divide_angle = radians(90);//radians(ch(../Param/DivideAngle));

matrix3 m_rotate = ident();
rotate(m_rotate, divide_angle, normal);
divide_axis *= m_rotate;


//BasePointの位置
float divide_ratio = 0.5 //ch(../Param);

vector center_pos;
for (int i = 0; i < nprimitives(0); i++) 
{
	center_pos += prim(0, "P", i);
}
center_pos /= nprimitives(0);

vector min_pos;
vector max_pos;
vector uvw;
intersect(0, center_pos, divide_axis, min_pos, uvw);
intersect(0, center_pos, -divide_axis, max_pos, uvw);

float length = length(min_pos - max_pos);

